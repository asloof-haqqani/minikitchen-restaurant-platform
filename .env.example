# Server-side only. Set this in Render; never use a VITE_ prefix for secrets.
GEMINI_API_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=

# Set to the deployed Netlify site URL in Render (no trailing slash).
FRONTEND_URL=

# Optional data directory. Render's free service has ephemeral storage;
# local development defaults to ./data.
DATA_DIR=

# Frontend build-time variable. Set to the Render API origin in Netlify.
VITE_API_URL=
