# Server-side only. Set these in Netlify; never use a VITE_ prefix for secrets.
GEMINI_API_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=

# Set to the deployed Netlify site URL (no trailing slash) if using a separate API host.
FRONTEND_URL=

# Optional local API data directory. Netlify Functions use temporary /tmp storage.
DATA_DIR=

# Optional separate API origin. Leave blank when using the Netlify Function.
VITE_API_URL=
